{
  "hosting": [
    {
      "target": "neo-os",
      "public": "dist/neo-os",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf|otf|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600,stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "**/*.@(mp3|wav|ogg|m4a|mp4|webm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=86400,stale-while-revalidate=604800"
            }
          ]
        }
      ]
    }
  ]
}
